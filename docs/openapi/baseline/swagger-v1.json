  "components": {
    "schemas": {
      "CustomResult": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "description": "Objeto de retorno da chamada",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ELocalizacaoMesa": {
        "enum": [
          0,
          1
        ],
        "type": "integer",
        "format": "int32"
      },
      "ETipoPrato": {
        "enum": [
          0,
          1,
          2
        ],
        "type": "integer",
        "format": "int32"
      },
      "LoginUserViewModel": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "maxLength": 100,
            "minLength": 6,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "MesaViewModel": {
        "required": [
          "localizacaoMesa",
          "numero"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "numero": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "lugares": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "ativo": {
            "type": "boolean"
          },
          "localizacaoMesa": {
            "$ref": "#/components/schemas/ELocalizacaoMesa"
          }
        },
        "additionalProperties": false
      },
      "PratoViewModel": {
        "required": [
          "descricao",
          "preco",
          "titulo"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "titulo": {
            "maxLength": 200,
            "minLength": 2,
            "type": "string"
          },
          "descricao": {
            "maxLength": 800,
            "minLength": 2,
            "type": "string"
          },
          "fotoUpload": {
            "type": "string",
            "nullable": true
          },
          "foto": {
            "type": "string",
            "nullable": true
          },
          "preco": {
            "type": "number",
            "format": "double"
          },
          "ativo": {
            "type": "boolean"
          },
          "tipoPrato": {
            "$ref": "#/components/schemas/ETipoPrato"
          }
        },
        "additionalProperties": false
      },
      "PratoViewModelPaginationResult": {
        "type": "object",
        "properties": {
          "pageNumber": {
            "type": "integer",
            "format": "int32"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          },
          "totalItens": {
            "type": "integer",
