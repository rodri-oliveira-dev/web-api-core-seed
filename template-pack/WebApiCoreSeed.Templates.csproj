<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>RodriOliveira.WebApiCoreSeed.Templates</PackageId>
    <PackageVersion>2.0.0-preview.1</PackageVersion>
    <Title>Web API Core Seed .NET project templates</Title>
    <Authors>Rodrigo de Oliveira</Authors>
    <Description>Installable .NET 10 Web API seed template with authentication, SQL Server, Redis, OpenTelemetry and tests.</Description>
    <PackageTags>dotnet-new;templates;aspnetcore;webapi;architecture;hexagonal</PackageTags>
    <PackageProjectUrl>https://github.com/rodri-oliveira-dev/web-api-core-seed</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rodri-oliveira-dev/web-api-core-seed</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageType>Template</PackageType>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <EnableDefaultItems>false</EnableDefaultItems>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <!-- Explicit allowlist: never ship repository-only automation, histories, or secrets. -->
  <ItemGroup>
    <Content Include="../.template.config/template.json" PackagePath="content/.template.config/template.json" />
    <Content Include="README.template.md" PackagePath="content/README.md" />
    <Content Include="README.template.pt-BR.md" PackagePath="content/README.pt-BR.md" />
    <Content Include="../src/**/*" Exclude="../src/**/bin/**;../src/**/obj/**;../src/**/TestResults/**" PackagePath="content/src/" />
    <Content Include="../tests/**/*" Exclude="../tests/**/bin/**;../tests/**/obj/**;../tests/**/TestResults/**" PackagePath="content/tests/" />
    <Content Include="../tools/**/*" Exclude="../tools/**/bin/**;../tools/**/obj/**" PackagePath="content/tools/" />
    <Content Include="../docs/openapi/**/*" PackagePath="content/docs/openapi/" />
    <Content Include="../scripts/docker/apply-migrations.sh" PackagePath="content/scripts/docker/" />
    <Content Include="../scripts/setup/configure-user-secrets.sh" PackagePath="content/scripts/setup/" />
    <Content Include="../scripts/setup/configure-user-secrets.ps1" PackagePath="content/scripts/setup/" />
    <Content Include="../global.json" PackagePath="content/" />
    <Content Include="../Directory.Build.props" PackagePath="content/" />
    <Content Include="../Directory.Packages.props" PackagePath="content/" />
    <Content Include="../WebApiCoreSeed.slnx" PackagePath="content/" />
    <Content Include="../Dockerfile" PackagePath="content/" />
    <Content Include="../compose.yaml" PackagePath="content/" />
    <Content Include="../.env.local.example" PackagePath="content/" />
    <Content Include="../.dockerignore" PackagePath="content/" />
    <Content Include="../.gitignore" PackagePath="content/" />
    <Content Include="../.editorconfig" PackagePath="content/" />
  </ItemGroup>
</Project>
