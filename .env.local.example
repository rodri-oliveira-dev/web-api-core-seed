JWT_SECRET=replace-with-at-least-32-random-characters-for-local-development
DEVELOPMENT_SEED_EMAIL=developer@example.local
DEVELOPMENT_SEED_PASSWORD=replace-with-a-local-development-password-that-meets-identity-policy
SQLSERVER_DATABASE=SampleRestaurantDb
API_HTTP_PORT=8080
SQLSERVER_HOST_PORT=1433
REDIS_HOST_PORT=7001
