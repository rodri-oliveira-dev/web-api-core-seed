      "exclude": [
        ".template.config/**",
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        "**/TestResults/**",
        "**/.vs/**",
        "**/.git/**",
        "**/*.user",
        "**/*.nupkg",
        "**/*.snupkg"
