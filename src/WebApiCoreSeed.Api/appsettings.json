{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {},
  "Cors": {
    "AllowedOrigins": [],
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ],
    "AllowedHeaders": [ "Authorization", "Content-Type", "X-ClientId" ],
    "AllowCredentials": false,
    "AllowWildcardSubdomains": true
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "RequestLimits": {
    "TimeoutSeconds": 30,
    "MaxRequestBodyBytes": 10485760
  },
  "AppSettings": {
    "Secret": "",
    "ExpiracaoHoras": 2,
    "Emissor": "WebApiCoreSeed",
    "ValidoEm": "https://localhost"
  },
  "NativeRateLimitingSettings": {
    "Public": {
      "PermitLimit": 3,
      "WindowSeconds": 1,
      "QueueLimit": 0
    },
    "Authenticated": {
      "PermitLimit": 3,
      "WindowSeconds": 1,
      "QueueLimit": 0
    },
    "AuthenticationSensitive": {
      "PermitLimit": 2,
      "WindowSeconds": 1,
      "QueueLimit": 0
    }
  },
  "RedisCacheSettings": {
    "Enabled": true,
    "ConnectionString": "localhost:7001",
    "InstanceName": "master",
    "DefaultSeconds": 60
  },
  "OpenTelemetry": {
    "Enabled": true,
    "ServiceName": "web-api-core-seed-api",
    "ServiceNamespace": "rodri-oliveira-dev.web-api-core-seed",
    "ServiceVersion": "",
    "Environment": "",
    "Tracing": {
      "SamplingRatio": 1.0,
      "RecordExceptions": true
    },
    "Metrics": {
      "RuntimeInstrumentation": true
    },
    "Otlp": {
      "Enabled": false,
      "Endpoint": "",
      "Protocol": "Grpc"
    }
  },
  "SeqSettings": {
    "Enabled": false,
    "Url": "http://localhost:5341",
    "FilePath": "logs\\web-api-core-seed.log"
  }
}
