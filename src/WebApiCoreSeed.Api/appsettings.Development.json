{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:44340",
      "https://localhost:5001",
      "http://localhost:5000"
    ],
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ],
    "AllowedHeaders": [ "Authorization", "Content-Type", "X-ClientId" ],
    "AllowCredentials": false,
    "AllowWildcardSubdomains": true
  },
  "SeqSettings": {
    "Enabled": false,
    "Url": "http://localhost:5341",
    "FilePath": "logs\\web-api-core-seed-development.log"
  }
}
