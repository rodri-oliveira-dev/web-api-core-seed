{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=localhost,1433;Initial Catalog=PedidosApi;User Id=sa;Password=CHANGE-ME-LOCAL-ONLY;Application Name=PedidosApi;MultipleActiveResultSets=true;TrustServerCertificate=True;"
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ],
    "AllowedHeaders": [ "Authorization", "Content-Type", "X-ClientId" ],
    "AllowCredentials": false,
    "AllowWildcardSubdomains": true
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "RequestLimits": {
    "TimeoutSeconds": 30,
    "MaxRequestBodyBytes": 10485760
  },
  "AppSettings": {
    "Secret": "CHANGE-ME-LOCAL-DEVELOPMENT-JWT-SECRET-32-CHARS",
    "ExpiracaoHoras": 2,
    "Emissor": "Restaurante",
    "ValidoEm": "https://localhost"
  },
  "NativeRateLimitingSettings": {
    "Public": {
      "PermitLimit": 3,
      "WindowSeconds": 1,
      "QueueLimit": 0
    },
    "Authenticated": {
      "PermitLimit": 3,
      "WindowSeconds": 1,
      "QueueLimit": 0
    },
    "AuthenticationSensitive": {
      "PermitLimit": 2,
      "WindowSeconds": 1,
      "QueueLimit": 0
    }
  },
  "RedisCacheSettings": {
    "Enabled": true,
    "ConnectionString": "localhost:7001",
    "InstanceName": "master",
    "DefaultSeconds": 60
  },
  "DatasulSeqSettings": {
    "Enabled": true,
    "Url": "http://localhost:5341",
    "FilePath": "C:\\estudos\\myapp.txt"
  }
}
