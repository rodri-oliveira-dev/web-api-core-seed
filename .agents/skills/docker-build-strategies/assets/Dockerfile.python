# syntax=docker/dockerfile:1

# --- Build stage ---
FROM python:3.13-slim AS build
WORKDIR /src

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install dependencies (cached separately from source)
COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-compile -r requirements.txt

# Copy application source
COPY . .

# --- Runtime stage ---
FROM python:3.13-slim AS runtime
WORKDIR /app

RUN addgroup --system --gid 1001 appgroup && \
    adduser --system --uid 1001 --ingroup appgroup appuser

# Copy virtual environment and application from build stage
COPY --from=build --chown=appuser:appgroup /opt/venv /opt/venv
COPY --from=build --chown=appuser:appgroup /src /app

ENV PATH="/opt/venv/bin:$PATH"

USER appuser
EXPOSE 8000

LABEL org.opencontainers.image.source="https://github.com/example/app"

ENTRYPOINT ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0"]
