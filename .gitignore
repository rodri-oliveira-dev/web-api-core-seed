# Test and coverage tools
*.VisualState.xml
TestResult.xml
nunit-*.xml
*.received.*
_NCrunch_*
.NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*
OpenCover/
*.dotCover
.axoCover/*
!.axoCover/settings.json

# NuGet packages
*.nupkg
*.snupkg

# Node and web tooling
node_modules/
.sass-cache/

# Python tooling
**/__pycache__/
*.pyc

# Database and local runtime files
*.mdf
*.ldf
*.ndf
*.db
*.db-shm
*.db-wal
healthchecksdb

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Local analysis and generated caches
.scannerwork/
*.[Cc]ache
!*.[Cc]ache/

# Keep repository assets that are intentionally versioned.
!**/Properties/launchSettings.json
!*.http
!docs/openapi/
!docs/openapi/**
