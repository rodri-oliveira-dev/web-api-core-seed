{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dotnet: restore solution",
      "type": "process",
      "command": "dotnet",
      "args": [
        "restore",
        "${workspaceFolder}/WebApiCoreSeed.slnx"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet: build solution",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/WebApiCoreSeed.slnx",
        "--no-restore"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet: test solution",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/WebApiCoreSeed.slnx",
        "--no-build"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet: run API",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/src/WebApiCoreSeed.Api/WebApiCoreSeed.Api.csproj"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "setup: configure git hooks",
      "type": "shell",
      "command": "./scripts/setup/configure-git-hooks.sh",
      "windows": {
        "command": "./scripts/setup/configure-git-hooks.ps1"
      },
      "problemMatcher": []
    },
    {
      "label": "setup: configure user secrets",
      "type": "shell",
      "command": "./scripts/setup/configure-user-secrets.sh",
      "windows": {
        "command": "./scripts/setup/configure-user-secrets.ps1"
      },
      "problemMatcher": []
    },
    {
      "label": "docker: validate compose",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "--env-file",
        ".env.local",
        "config"
      ],
      "problemMatcher": []
    },
    {
      "label": "docker: build",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "--env-file",
        ".env.local",
        "build"
      ],
      "problemMatcher": []
    },
    {
      "label": "docker: up",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "--env-file",
        ".env.local",
        "up",
        "-d"
      ],
      "problemMatcher": []
    },
    {
      "label": "docker: logs api",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "--env-file",
        ".env.local",
        "logs",
        "-f",
        "api"
      ],
      "problemMatcher": []
    },
    {
      "label": "docker: down",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "--env-file",
        ".env.local",
        "down"
      ],
      "problemMatcher": []
    },
    {
      "label": "docker: reset local data",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "--env-file",
        ".env.local",
        "down",
        "--volumes"
      ],
      "problemMatcher": []
    },
    {
      "label": "setup: check git hooks",
      "type": "shell",
      "command": "./scripts/setup/configure-git-hooks.sh --check",
      "windows": {
        "command": "./scripts/setup/configure-git-hooks.ps1 -Check"
      },
      "problemMatcher": []
    }
  ]
}
